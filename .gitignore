# --- Systemowe ---
.DS_Store
Thumbs.db
.cache
__pycache__/
*.py[cod]
*$py.class

# --- Streamlit ---
# BLOKUJEMY sekrety (musisz je wkleić ręcznie w panelu Streamlit Cloud)
.streamlit/secrets.toml

# POZWALAMY na konfigurację wyglądu
!.streamlit/config.toml

# --- Dane i Cache ---
